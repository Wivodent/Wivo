node_modules
dist
out
.env
# No longer read: test mode's URL and anon key are in config/test-copy.env
# (tracked). Ignored so a leftover copy is never committed.
.env.test
# A person's own fake-data project (docs/TEST-PROJECT.md). The .example is tracked.
config/test-fake.env
*.local
*.tsbuildinfo

# Licence signing key — NEVER commit. See scripts/make-license.mjs
license-private.pem
# A development test keypair, and the public half the app reads through
# WIVO_LICENCE_TEST_KEY. Neither goes in: a packaged build refuses a file key
# anyway (src/main/license.ts), and a key in git is a key everyone has.
license-*.pem
license-*.hex
dist-mobile

# A clinic's installer (clinics/README.md): its public key, and its output
clinics/*.env
/dist-*/

# A clinic's signed releases (docs/RELEASE.md): built, signed and published from here
/releases/

# Before clinics/: Riga's env file and installers, until Kevin moves or deletes them
riga.env
dist-riga
release-riga

# The original work type pictures (large PNGs). Never committed: the app uses
# the WebP files scripts/optimize-worktype-images.mjs makes from them.
/assets-src/
